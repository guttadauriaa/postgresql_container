FROM php:8.5-apache

RUN apt-get update && apt-get install -y \
    libpq-dev \
    && docker-php-ext-install pdo pdo_pgsql pgsql \
    && apt-get clean \
    && rm -rf /var/lib/lists/*

COPY ./apache/site-ssl.conf /etc/apache2/sites-available/site-ssl.conf

RUN a2enmod ssl \
    && a2dissite default-ssl \
    && a2ensite site-ssl \
    && a2enmod rewrite
